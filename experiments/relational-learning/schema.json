{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relational preference pair v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "family_id",
    "split",
    "category",
    "variant",
    "context",
    "chosen",
    "rejected",
    "review_status",
    "provenance",
    "review_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "integer",
      "minimum": 1
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "chosen": {
      "type": "string",
      "minLength": 1
    },
    "rejected": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "synthetic_unreviewed",
        "human_reviewed",
        "disputed"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "consent",
        "usage"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "consent": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_notes": {
      "type": "string"
    }
  }
}
